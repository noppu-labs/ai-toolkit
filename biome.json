{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "domains": { "react": "all", "test": "all" },
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useExplicitType": "error",
        "useTailwindSortedClasses": "error"
      },
      "complexity": {
        "noImportantStyles": "error",
        "noExcessiveCognitiveComplexity": {
          "options": {
            "maxAllowedComplexity": 10
          },
          "level": "error"
        }
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noReExportAll": "error",
        "noBarrelFile": "error",
        "noJsxPropsBind": "error"
      },
      "security": {
        "noSecrets": {
          "options": {
            "entropyThreshold": 45
          },
          "level": "error"
        }
      },
      "style": {
        "noEnum": "error",
        "noExportedImports": "error",
        "useComponentExportOnlyModules": "error",
        "noHexColors": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noMisplacedAssertion": "error",
        "noForIn": "error",
        "noNestedPromises": "error",
        "noLeakedRender": "error",
        "noDuplicateSelectors": "error",
        "useExpect": "off"
      },
      "correctness": {
        "noComponentHookFactories": "error"
      }
    }
  },
  "tailwind": {
    "stylesheet": "./site/src/css/app.css"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": ["**", "!review/workflows"]
  }
}
