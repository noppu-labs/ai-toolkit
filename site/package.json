    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.0",
    "astro": "^7.4.13",
    "playwright": "^1.65.1",
    "satteri": "^0.11.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0",
    "yaml": "^2.9.1"
