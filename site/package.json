{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "browsers:install": "playwright install chromium --with-deps",
    "prebuild": "tsx scripts/build-catalog.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts",
    "predev": "tsx scripts/build-catalog.ts",
    "dev": "vite dev",
    "og-image": "tsx scripts/og-image.ts",
    "pretest": "tsx scripts/build-catalog.ts",
    "test": "vitest run --browser.headless",
    "coverage:worker": "vitest run --project unit --coverage worker",
    "pretypecheck": "tsx scripts/build-catalog.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0"
  }
}
