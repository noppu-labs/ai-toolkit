{
  "name": "site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "browsers:install": "playwright install chromium --with-deps",
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "og-image": "tsx scripts/og-image.ts",
    "sync:opencode": "tsx scripts/opencode/cli.ts",
    "test": "vitest run --browser.headless --project unit --project components",
    "test:dist": "vitest run --project dist",
    "test:preview": "vitest run --project preview",
    "coverage:worker": "vitest run --project unit --coverage worker",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
