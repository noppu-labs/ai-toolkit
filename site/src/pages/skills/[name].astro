---
import { type CollectionEntry, getEntry, render } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { SkillDetailBody } from "../../components/catalog/SkillDetail.tsx";
import Base from "../../layouts/Base.astro";
import { type CatalogSkill, catalogSkills } from "../../lib/catalog.ts";
import { loadCatalog } from "../../lib/load-catalog.ts";
import { pageHead, skillPages } from "../../lib/pages.ts";
import { SkillPage } from "../../SkillPage.tsx";

interface Props {
  skill: CatalogSkill;
  siblings: CatalogSkill[];
}

interface SkillPath {
  params: { name: string };
  props: Props;
}

export async function getStaticPaths(): Promise<SkillPath[]> {
  const { plugins } = await loadCatalog();
  return skillPages(catalogSkills(plugins)).map(({ skill, siblings }) => ({
    params: { name: skill.name },
    props: { skill, siblings },
  }));
}

const { skill, siblings }: Props = Astro.props;
const entry: CollectionEntry<"skills"> | undefined = await getEntry(
  "skills",
  skill.name,
);
if (entry === undefined) {
  throw new Error(`no SKILL.md body for ${skill.name}`);
}
const { Content }: { Content: AstroComponentFactory } = await render(entry);
---

<Base head={pageHead({ kind: "skill", skill, siblings })} sectionBase="/">
  <SkillPage skill={skill} siblings={siblings}>
    <SkillDetailBody client:idle skill={skill} surface="pane" />
    <div slot="body"><Content /></div>
  </SkillPage>
</Base>
