{
  "type": "module",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "coverage-ci": "vitest run --coverage",
    "fuzz": "FC_NUM_RUNS=${FC_NUM_RUNS:-1000} vitest run --testTimeout=600000 scripts",
    "lint": "biome check . && markdownlint-cli2",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix",
    "lint:python": "scripts/python-checks.sh",
    "sync": "tsx scripts/sync.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "markdownlint-cli2": "^0.23.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
