{
  "name": "ai-toolkit",
  "compatibility_date": "2026-10-07",
  // Prevents pushes to main from publishing a 2nd public copy.
  "workers_dev": false,
  // Serves the npm downloads badge; every other path is a static asset.
  "main": "./site/worker/index.ts",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    // Only the badge API runs the script before assets are matched.
    "run_worker_first": ["/api/*"],
    // Serves site/public/404.html instead of an empty 404.
    "not_found_handling": "404-page",
    // Astro writes skills/<name>/index.html; this serves it at /skills/<name>.
    "html_handling": "drop-trailing-slash"
  },
  // Matches the dashboard's settings, so deploys do not drift from them. Only
  // /api/* runs the script, so sampling every request stays cheap.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // wrangler preview refuses to run without this block, even empty.
  "previews": {}
}
