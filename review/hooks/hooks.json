{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*.output*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-task-output.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(//**/*.output)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-task-output.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
